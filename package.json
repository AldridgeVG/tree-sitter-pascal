{
  "name": "@fsdev/tree-sitter-pascal",
  "version": "1.0.3",
  "author": "AldridgeVG",
  "license": "MIT",
  "description": "Tree-sitter grammar for Pascal and its dialects (Delphi, FreePascal)",
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "files": [
    "bindings/node/*",
    "src/*.c",
    "src/*.h",
    "src/tree_sitter/*.h",
    "prebuilds/**/*",
    "binding.gyp"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "node-gyp rebuild",
    "prebuild": "prebuildify --napi --strip",
    "install": "node-gyp-build"
  },
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "prebuildify": "^6.0.0"
  },
  "peerDependencies": {
    "tree-sitter": "0.22.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "http://nexus.fscut.com/repository/npm-dev/"
  },
  "tree-sitter": [
    {
      "scope": "source.pascal",
      "file-types": [
        "pas",
        "dpr",
        "dpk",
        "lpr",
        "pp"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  ]
}
